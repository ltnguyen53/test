# Sao chép file này thành .env rồi điền giá trị thật.
# .env KHÔNG được commit — xem .gitignore. File này (.env.example) mới là
# thứ được commit, để người khác biết cần khai báo biến gì.

# DagsHub — dùng làm DVC remote + MLflow tracking server (roadmap mục 4.2, 4.3)
DAGSHUB_USERNAME=
DAGSHUB_TOKEN=
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow

# Neon Postgres — log prediction phục vụ monitoring (roadmap mục 4.8, tuần 9)
DATABASE_URL=

# Override config qua env theo quy ước trong config/loader.py: APP__<section>__<field>
# Ví dụ (không cần bật mặc định, chỉ để minh hoạ):
# APP__phase1__epochs=5
